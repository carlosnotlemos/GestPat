/ Mensagens de sucesso (notice)
- if flash[:notice].present?
  .toast-container.position-fixed.top-0.end-0.p-3{style: "z-index: 1050;"}
    .toast.show.border-0.shadow-lg.rounded-3.overflow-hidden.animate__animated.animate__fadeInDown.js-toast{role: "alert", "aria-live": "assertive", "aria-atomic": "true", style: "background-color: #ecfdf5; border: 1px solid #10b981;"}
      .d-flex.align-items-center.p-3
        .flex-shrink-0
          .rounded-circle.d-flex.align-items-center.justify-content-center{style: "width: 40px; height: 40px; background: #10b981;"}
            %i.fas.fa-check-circle.text-white
        .flex-grow-1.ms-3
          %h6.mb-1.text-gray-900.fw-semibold.small.uppercase.tracking-wide{style: "letter-spacing: 0.05em; font-size: 0.75rem; color: #059669;"}
            Sucesso
          %p.mb-0.text-gray-800= flash[:notice]
        .flex-shrink-0.ms-3
          %button.btn.btn-close{"data-bs-dismiss": "toast", "aria-label": "Close", type: "button"}

