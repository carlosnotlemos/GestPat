:css
  .toast {
    transition: all 0.3s ease;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08) !important;
  }
  
  .toast:hover {
    transform: translateX(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12) !important;
    opacity: 0.95;
  }