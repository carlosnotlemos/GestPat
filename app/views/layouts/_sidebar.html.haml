= stylesheet_link_tag 'sidebar', "data-turbo-track": "reload"

/ Overlay para mobile (fora do sidebar)
.sidebar-overlay

/ Botão toggle para mobile
%button.sidebar-toggle.d-lg-none{type: "button"}
  %i.fas.fa-bars

#wrapper.d-flex
  / Sidebar com classe para controle mobile
  #accordionSidebar.sidebar.bg-gradient-primary.text-white
    .sidebar-heading.p-4
      %h5.mb-0.fw-bold.text-white
        %i.fas.fa-chart-line.me-2
        NEXA PRO
      %button.btn-close-sidebar.d-lg-none{type: "button", style: "display: none;"}
        %i.fas.fa-times
    
    .sidebar-content.py-3
      %ul.nav.flex-column
        %li.nav-item
          = link_to root_path, class: "nav-link text-white py-3 px-4 d-flex w-100 align-items-center active-item" do
            %i.fas.fa-fw.fa-tachometer-alt.me-3
            %span Dashboard
        
        %li.nav-item
          = link_to "#", class: "nav-link text-white py-3 px-4 d-flex w-100 align-items-center" do
            %i.fas.fa-fw.fa-chart-bar.me-3
            %span Analytics
            %span.badge.bg-info.rounded-pill.ms-auto 3
        
        %li.nav-item
          = link_to "#", class: "nav-link text-white py-3 px-4 d-flex w-100 align-items-center" do
            %i.fas.fa-fw.fa-users.me-3
            %span Users
        
        %li.nav-item
          = link_to "#", class: "nav-link text-white py-3 px-4 d-flex w-100 align-items-center" do
            %i.fas.fa-fw.fa-cogs.me-3
            %span Settings

        %li.nav-item.mt-5
          %hr.bg-light
          = button_to destroy_user_session_path, method: :delete, 
            class: "nav-link logout-simple py-3 px-4 d-flex w-100 align-items-center rounded" do
            %i.fas.fa-fw.fa-sign-out-alt.me-3
            %span.fw-semibold Sair

:javascript
  // Controle do sidebar mobile
  document.addEventListener('turbo:load', function() {
    const sidebar = document.getElementById('accordionSidebar');
    const sidebarToggle = document.querySelector('.sidebar-toggle');
    const sidebarOverlay = document.querySelector('.sidebar-overlay');
    const closeSidebarBtn = document.querySelector('.btn-close-sidebar');
    
    // Abrir sidebar
    if (sidebarToggle) {
      sidebarToggle.addEventListener('click', function() {
        sidebar.classList.add('active');
        sidebarOverlay.classList.add('active');
      });
    }
    
    // Fechar sidebar pelo overlay
    if (sidebarOverlay) {
      sidebarOverlay.addEventListener('click', function() {
        sidebar.classList.remove('active');
        this.classList.remove('active');
      });
    }
    
    // Fechar sidebar pelo botão de fechar
    if (closeSidebarBtn) {
      closeSidebarBtn.addEventListener('click', function() {
        sidebar.classList.remove('active');
        sidebarOverlay.classList.remove('active');
      });
    }
    
    // Fechar sidebar ao clicar em um link (opcional para mobile)
    const sidebarLinks = document.querySelectorAll('.sidebar .nav-link');
    sidebarLinks.forEach(link => {
      link.addEventListener('click', function() {
        if (window.innerWidth < 992) {
          sidebar.classList.remove('active');
          sidebarOverlay.classList.remove('active');
        }
      });
    });
    
    // Fechar sidebar ao redimensionar para desktop
    function handleResize() {
      if (window.innerWidth >= 992) {
        sidebar.classList.remove('active');
        if (sidebarOverlay) {
          sidebarOverlay.classList.remove('active');
        }
      }
    }
    
    window.addEventListener('resize', handleResize);
    handleResize(); // Executa uma vez ao carregar
  });
