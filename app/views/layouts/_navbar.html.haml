= stylesheet_link_tag 'components/navbar', "data-turbo-track": "reload"

%nav.navbar.navbar-expand.navbar-light.bg-white.topbar.mb-4.shadow-sm.border-bottom
  .container-fluid.px-3.px-md-4
    / Lado esquerdo - Título e breadcrumb
    .navbar-brand.me-3.d-none.d-lg-block
      %span.text-muted.h6 Bem Vindo #{current_user.name.titleize}!
    
    / Lado direito - Itens do usuário
    %ul.navbar-nav.ms-auto.d-flex.flex-row.align-items-center
      
      / Notificações
      %li.nav-item.dropdown.mx-1
        %a.nav-link.position-relative{href: "#", role: "button", data: { bs_toggle: "dropdown" }}
          %i.fas.fa-bell.text-gray-600
          %span.position-absolute.start-100.badge.rounded-pill.bg-danger{style: "top: 15px; transform: translate(-50%, 0); font-size: 0.6rem; padding: 0.2rem 0.4rem;"}
            3
        .dropdown-menu.dropdown-menu-end.shadow.border-0.mt-2{style: "min-width: 300px;"}
          .dropdown-header.d-flex.justify-content-between.align-items-center
            %span.fw-bold Notificações
            %span.badge.bg-primary.rounded-pill 3 novas
          .dropdown-divider
          = link_to "#", class: "dropdown-item py-2" do
            .d-flex.align-items-center
              .flex-shrink-0
                .icon-circle.bg-primary.bg-opacity-10.text-primary.rounded-circle.p-2.me-3
                  %i.fas.fa-file-alt.fa-lg.text-dark
              .flex-grow-1
                .small.text-gray-800 Novo relatório disponível
                .small.text-muted Há 12 minutos
          
          = link_to "#", class: "dropdown-item py-2" do
            .d-flex.align-items-center
              .flex-shrink-0
                .icon-circle.bg-success.bg-opacity-10.text-success.rounded-circle.p-2.me-3
                  %i.fas.fa-check.fa-lg.text-dark
              .flex-grow-1
                .small.text-gray-800 Tarefa concluída
                .small.text-muted Há 1 hora
          
          .dropdown-divider
          = link_to "#", class: "dropdown-item text-center text-primary small py-2" do
            Ver todas as notificações
            %i.fas.fa-arrow-right.ms-1
      
      / Mensagens
      %li.nav-item.dropdown.mx-1
        %a.nav-link.position-relative{href: "#", role: "button", data: { bs_toggle: "dropdown" }}
          %i.fas.fa-envelope.text-gray-600
          %span.position-absolute.start-100.badge.rounded-pill.bg-warning{style: "top: 15px; transform: translate(-50%, 0); font-size: 0.6rem; padding: 0.2rem 0.4rem;"}
            5
        .dropdown-menu.dropdown-menu-end.shadow.border-0.mt-2{style: "min-width: 280px;"}
          .dropdown-header.d-flex.justify-content-between.align-items-center
            %span.fw-bold Mensagens
            %span.badge.bg-warning.rounded-pill 5 não lidas
          .dropdown-divider
          = link_to "#", class: "dropdown-item py-2" do
            .d-flex
              .flex-shrink-0
                .rounded-circle.bg-primary.d-flex.align-items-center.justify-content-center{style: "width: 36px; height: 36px;"}
                  %span.fw-bold.text-dark JD
              .flex-grow-1.ms-3
                %strong João Silva
                .small.text-muted.text-truncate{style: "max-width: 180px;"}
                  | Precisamos conversar sobre o projeto...
                .small.text-muted Há 30 minutos
          
          = link_to "#", class: "dropdown-item text-center text-primary small py-2" do
            Ver todas as mensagens
            %i.fas.fa-arrow-right.ms-1
      
      / Separador
      %li.nav-item.mx-2.d-none.d-xl-block
        .vr{style: "height: 24px;"}
      
      / Usuário
      %li.nav-item.dropdown
        %a.nav-link.d-flex.align-items-center{href: "#", role: "button", data: { bs_toggle: "dropdown" }}
          .d-none.d-md-block.me-2.text-end
            .small.text-gray-600.fw-semibold= current_user.name.split(' ').first
            .small.text-muted Administrador
          .user-avatar.rounded-circle.bg-gradient-primary.text-white.d-flex.align-items-center.justify-content-center{style: "width: 36px; height: 36px;"}
            %i.fas.fa-user
          %i.fas.fa-chevron-down.small.ms-2
        .dropdown-menu.dropdown-menu-end.shadow.border-0.mt-2
          .dropdown-header.py-2.d-lg-none
            .d-flex.align-items-center
              .user-avatar.rounded-circle.bg-gradient-primary.text-white.d-flex.align-items-center.justify-content-center.me-3{style: "width: 40px; height: 40px;"}
                %i.fas.fa-user
              .flex-grow-1
                .fw-bold= current_user.email.split('@').first
                .small.text-muted= current_user.email
          .dropdown-divider
          = link_to "#", class: "dropdown-item py-2 w-100" do
            %i.fas.fa-user.me-2.text-gray-400
            Meu Perfil
          = link_to "#", class: "dropdown-item py-2 w-100" do
            %i.fas.fa-cog.me-2.text-gray-400
            Configurações
          = link_to "#", class: "dropdown-item py-2 w-100" do
            %i.fas.fa-chart-line.me-2.text-gray-400
            Estatísticas
          .dropdown-divider
          = link_to destroy_user_session_path, method: :delete, class: "dropdown-item py-2 text-danger w-100" do
            %i.fas.fa-sign-out-alt.me-2
            Sair