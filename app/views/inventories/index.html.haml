.card.shadow-sm.border-0
  .card-body
    .d-flex.justify-content-between.align-items-center.mb-4
      %h6.mb-0.text-gray-800
        %i.fas.fa-box-open.me-2
        | Inventários Realizados

    .table-responsive
      %table.table.table-striped
        %thead
          %tr
            %th Inventário
            %th Local
            %th Itens
            %th Status
            %th Progresso
        %tbody
          %tr
            %td
              .fw-bold Trimestral Q2
              .small.text-muted Realizado em: 01/06/2024
            %td Armazém Central
            %td 128
            %td
              %span.badge.bg-success
                %i.fas.fa-spinner.fa-spin.me-1
                Em Andamento
            %td
              .progress{style: "height: 6px"}
                .progress-bar{style: "width: 65%"}