.card.shadow-sm.border-0
  .card-header.py-3.bg-primary
    %span.d-flex.justify-content-start.align-items-center.text-white
      %i.fas.fa-box-open.me-2
      %h5.m-0.font-weight-bold | Inventários

  .card-body
    .table-responsive
      %table.table.table-striped
        %thead
          %tr
            %th Realizado em
            %th Local
            %th Itens 
            %th Itens Encontrados
            %th Progresso
        %tbody
          %tr
            %td
              .fw-bold 01/06/2024
              .small.text-muted # 125
            %td Armazém Central
            %td 128
            %td 1
            %td
              %span.badge.bg-success
                %i.fas.fa-spinner.fa-spin.me-1
                Em Andamento