:css
  #content-wrapper {
    background-color: #f8f9fc;
    width: 100%;
    overflow-x: hidden;
  }
  
  .container-fluid {
    padding: 20px;
  }
  
  .card {
    border: none;
    border-radius: 0.35rem;
    box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    margin-bottom: 1.5rem;
  }
  
  .card-header {
    background-color: #fff;
    border-bottom: 1px solid #e3e6f0;
    padding: 0.75rem 1.25rem;
    border-radius: calc(0.35rem - 1px) calc(0.35rem - 1px) 0 0;
  }
  
  .card-header h6 {
    font-weight: 700;
    color: #4e73df;
    margin: 0;
  }
  
  .card-body {
    padding: 1.25rem;
  }
  
  .btn-primary {
    background-color: #4e73df;
    border-color: #4e73df;
  }
  
  .btn-primary:hover {
    background-color: #2e59d9;
    border-color: #2653d4;
  }
  
  .form-label {
    font-weight: 600;
    color: #5a5c69;
  }
  
  .form-control {
    border: 1px solid #d1d3e2;
    border-radius: 0.35rem;
    padding: 0.375rem 0.75rem;
  }
  
  .form-control:focus {
    border-color: #bac8f3;
    box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
  }
  
  .table {
    width: 100%;
    color: #858796;
  }
  
  .table th {
    border-top: none;
    font-weight: 700;
    color: #4e73df;
  }
  
  .navbar {
    background-color: #fff;
    box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    padding: 0.5rem 1rem;
  }
  
  .inventory-preview {
    background-color: #f8f9fa;
    border: 1px dashed #d1d3e2;
    border-radius: 0.35rem;
    padding: 15px;
    margin-top: 20px;
  }
  
  .inventory-preview h6 {
    color: #4e73df;
    font-weight: 600;
    margin-bottom: 15px;
  }
  
  .preview-item {
    padding: 5px 0;
    border-bottom: 1px solid #e3e6f0;
  }
  
  .preview-item:last-child {
    border-bottom: none;
  }
  
  .preview-label {
    font-weight: 600;
    color: #5a5c69;
    display: inline-block;
    width: 150px;
  }
