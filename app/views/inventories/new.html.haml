.d-sm-flex.align-items-center.justify-content-between.mb-4
  %h1.h3.mb-0.text-gray-800
    %i.fas.fa-plus-circle.mr-2
    Criar Novo Inventário

.row
  .col-lg-8
    .card.shadow.mb-4
      .card-header.py-3
        %h6.m-0.font-weight-bold.text-primary Informações do Inventário
      .card-body
        .row
          .col-md-6.mb-3
            %label.form-label{:for => "inventory-name"} Nome do Inventário
            %input#inventory-name.form-control{type: "text", placeholder: "Ex: Inventário Trimestral", value: "Inventário de Estoque - Q2 2024"}
          
          .col-md-6.mb-3
            %label.form-label{:for => "inventory-date"} Data do Inventário
            %input#inventory-date.form-control{type: "date", value: "2024-06-15"}
          
          .col-md-6.mb-3
            %label.form-label{:for => "inventory-location"} Localização
            %select#inventory-location.form-control
              %option{selected: true} Armazém Principal
              %option Armazém Secundário
              %option Loja Centro
              %option Loja Shopping
          
          .col-md-6.mb-3
            %label.form-label{:for => "inventory-responsible"} Responsável
            %input#inventory-responsible.form-control{type: "text", placeholder: "Nome do responsável", value: "Carlos Silva"}
          
          .col-md-12.mb-3
            %label.form-label{:for => "inventory-notes"} Observações
            %textarea#inventory-notes.form-control{rows: "3", placeholder: "Adicione observações relevantes..."} Verificação trimestral de estoque com foco em produtos eletrônicos e perecíveis.
          
          .col-md-12
            %button.btn.btn-primary.btn-icon-split
              %span.icon.text-white-50
                %i.fas.fa-check
              %span.text Salvar Inventário
  
  .col-lg-4
    .card.shadow.mb-4
      .card-header.py-3
        %h6.m-0.font-weight-bold.text-primary Estatísticas
      .card-body
        .row.text-center
          .col-6.mb-4
            .h5.font-weight-bold.text-primary 128
            %small Total de Itens
          .col-6.mb-4
            .h5.font-weight-bold.text-success 45
            %small Categorias
        
        %hr.my-4
        
        %h6.font-weight-bold.text-gray-800.mb-3 Status do Sistema
        .custom-control.custom-switch.mb-2
          %input#system-status.custom-control-input{type: "checkbox", checked: true}
          %label.custom-control-label{:for => "system-status"} Sistema Ativo
        
        .custom-control.custom-switch.mb-2
          %input#auto-backup.custom-control-input{type: "checkbox", checked: true}
          %label.custom-control-label{:for => "auto-backup"} Backup Automático
        
        .custom-control.custom-switch.mb-2
          %input#email-notifications.custom-control-input{type: "checkbox", checked: false}
          %label.custom-control-label{:for => "email-notifications"} Notificações por Email