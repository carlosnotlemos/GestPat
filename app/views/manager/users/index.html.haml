.card.shadow-sm.border-0
  .card-header.bg-primary.d-flex.justify-content-between.align-items-center
    %h6.text-white.mb-0.d-flex.align-items-center
      %i.fas.fa-box-open.me-2
      | Inventários Ativos
    = link_to [:new, :manager, :user], class: "btn btn-warning btn-sm rounded-pill d-flex align-items-center" do
      Novo Usuário
      %i.fas.fa-arrow-right.ms-1
  .card-body
    .table-responsive
      %table.table.table-striped.table-bordered
        %thead
          %tr
            %th Nome
            %th Email
            %th Permissão
        %tbody
          - @users.each do |user|
            %tr
              %td
                .fw-bold= user.name
                .small.text-muted Registrado em: #{l(user.created_at.to_date)}
              %td= user.email
              %td= user.role