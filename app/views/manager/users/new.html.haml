.d-sm-flex.align-items-center.justify-content-between.mb-4
  %h1.h3.mb-0.text-gray-800
    %i.fas.fa-plus-circle.mr-2
    Criar Novo Usuário

.row
  .col-lg-8
    = form_with model: [:manager, @user], class: "form" do |f|
      .card.shadow.mb-4
        .card-header.py-3
          %h6.m-0.font-weight-bold.text-primary Informações do Usuário
        .card-body
          .row
            .col-md-6.mb-3
              = f.label :name, "Nome do Usuário"
              = f.text_field :name, class: "form-control", placeholder: "Nome completo"
            
            .col-md-6.mb-3
              = f.label :email, "Email do Usuário"
              = f.email_field :email, class: "form-control", placeholder: "Email do usuário"
            
            .col-md-6.mb-3
              %label.form-label{:for => "inventory-location"} Locais disponíveis
              %select#inventory-location.form-control
                %option{selected: true} Armazém Principal
                %option Armazém Secundário
                %option Loja Centro
                %option Loja Shopping

            .col-md-6.mb-3
              = f.label :created_at, "Data de Cadastro"
              = f.date_field :created_at, class: "form-control", value: Date.today, disabled: true

            .col-md-6.mb-3
              = f.label :role, "Permissão do usuário"
              = f.select :role, User.roles.keys,{}, class: "form-select"
            
            .col-md-12
              .d-flex.justify-content-between
                = f.button type: "submit", class: " btn btn-primary btn-icon-split" do
                  %span.icon.text-white-50
                    %i.fas.fa-check
                  %span.text Salvar Inventário

                = link_to root_path, class: " btn btn-secondary btn-icon-split" do
                  %span.icon.text-white-50
                    %i.fas.fa-angle-left
                  %span.text Voltar

